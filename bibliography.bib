@incollection{pereboom2022kants,
  author = {Pereboom, Derk},
  editor = {Zalta, Edward N. and Nodelman, Uri},
  title = {Kant’s Transcendental Arguments},
  booktitle = {The Stanford Encyclopedia of Philosophy},
  url = {https://plato.stanford.edu/archives/fall2022/entries/kant-transcendental/},
  abstract = {Among Immanuel Kant’s (1724–1804) most influentialcontributions to philosophy is his development of the transcendentalargument. In Kant’s conception, an argument of this kind beginswith a compelling premise about our thought, experience, or knowledge,and then reasons to a conclusion that is a substantive and unobviouspresupposition and necessary condition of this premise. The crucialsteps in this reasoning are claims to the effect that a subconclusionor conclusion is a presupposition and necessary condition of apremise. Such a necessary condition might be a logically necessarycondition, but often in Kant’s transcendental arguments thecondition is necessary in the sense that it is the only possibleexplanation for the premise, whereupon the necessity might be weakerthan logical. Typically, this reasoning is intended to be apriori in some sense, either strict (Smit 1999) or more relaxed(Philip Kitcher 1981, Pereboom 1990). The conclusion of the argumentis often directed against skepticism of some sort. For example,Kant’s Transcendental Deduction targets Humean skepticism aboutthe applicability of a priori metaphysical concepts, and hisRefutation of Idealism takes aim at skepticism about external objects.These two transcendental arguments are found in the Critique ofPure Reason (1781, 1787), but such arguments are found throughoutKant’s writings, for example in the Groundwork of theMetaphysics of Morals (1785), in the Critique of PracticalReason (1788), in the Critique of the Power of Judgment(1790), and in the Opus Posthumum (1804; Förster 1989).This article focuses on the Transcendental Deduction, the Refutationof Idealism, and more recent transcendental arguments that areinspired by Kant’s work.伊曼纽尔·康德（Immanuel Kant，1724-1804）对哲学最有影响力的贡献之一是他对先验论证的发展。在康德的构想中，这种论证始于一个关于我们的思想、经验或知识的令人信服的前提，然后推理得出一个结论，这个结论是一个实质性的、不明显的前提和这个前提的必要条件。这种推理的关键步骤是声称子结论或结论是前提的前提和必要条件。这样的必要条件可能是逻辑上的必然条件，但在康德的先验论证中，条件往往是必然的，因为它是对前提的唯一可能的解释，因此必然性可能比逻辑上的要弱。通常，这种推理在某种意义上是先验的，要么是严格的（Smit 1999），要么是更宽松的（Philip Kitcher 1981，Pereboom 1990）。论证的结论通常是针对某种怀疑主义的。例如，康德的《先验演绎》针对的是休谟对先验形而上学概念适用性的怀疑，而他的《对唯心主义的驳斥》则针对对外部对象的怀疑。这两个先验论证见于《纯粹理性批判》（1781年，1787年），但这种论证在康德的著作中随处可见，例如在《道德形而上学的基础》（1785年）、《实践理性批判》（1788年）、《判断力批判》（1790年）和《后作》（1804年;Förster 1989）。本文重点介绍先验演绎、对唯心主义的驳斥，以及受康德著作启发的更近代的先验论证。},
  publisher = {Metaphysics Research Lab, Stanford University},
  edition = {Fall 2022},
}

