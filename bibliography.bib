@article{ref2018evh3uq4k,
  author = {史现明},
  title = {论阿伦特的“阿基米德点科学”},
  journal = {自然辩证法研究},
  volume = {34},
  number = {4},
  pages = {96-101},
  abstract = {阿伦特在对当代科学技术的批判思考中提出了著名的"阿基米德点科学"的概念。针对当代科学技术对人类整体影响的问题,她作出了"世界异化"与"地球异化"的基本判断。在其中她阐释了"普遍科学"与"自然科学"的对立,并表现出对"阿基米德点科学"无穷后退的担忧。她认为存在着这样一个"悖论",这一悖论使人类难逃地球"特洛伊木马"的身份嫌疑。而普列斯纳的"离心定位"(eccentricity)理论则在很大程度上消解了这一"悖论"。尽管如此,阿伦特把"阿基米德点科学"的思想与其"积极生活"理论以独特的方式融贯在一起,对我们深入认识科学技术的本质及其政治、社会价值都提供了有益的借鉴。},
  language = {zh},
  note = {Fund: 国家社科基金后期资助项目“海德格尔科学哲学思想研究”(17FZX041)； 河南省教育厅项目“阿伦特与海德格尔科学技术思想比较研究”(2017-ZZJH-371)；},
