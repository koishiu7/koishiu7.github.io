@article{ref2025rg97kcbd,
  author = {戴, 淑琳 and 姜, 萍},
  title = {人类基因增强技术应用的伦理困境与责任重构},
  journal = {医学与哲学},
  volume = {46},
  number = {23},
  pages = {13},
  abstract = {From the cross-temporal perspective of Hans Jonas's ethics of responsibility, the application of human genetic enhancement technology faces three ethical dilemmas: technical intervention undermines the genetic stability of human gene pool and challenges formal responsibility; intergenerational imbalance in the distribution of technological benefits disrupts nonreciprocal responsibility; and the technology commercialization and power alienation deviate from public welfare, violating substantive responsibility. The root cause lies in the mismatch between technological power and responsibility ethics, the spatiotemporal imbalance of the intergenerational responsibility relationship, and the lack of responsibility for technological consequences. Therefore, it is necessary to reconstruct the ethical framework of technological responsibility: safeguarding the human gene pool as the foundation for the survival of civilization, clarifying intergenerational responsibility with justice between generations as the core, and strengthening self-regulation in technological application with public welfare as the guiding principle. This reconstruction aims to achieve the harmonious coexistence of technological rationality and humanistic values.},
  language = {zh},
}

@article{ref2025xqq2qv77,
  author = {于云},
  title = {阿伦特论人工智能},
  journal = {艺术管理（中英文）},
  number = {1},
  pages = {13-24},
  abstract = {汉娜·阿伦特(Hannah Arendt)以发现“阿基米德点”获得的宇宙视角揭示了地球异化、世界异化及现代性危机形成的原因。人工智能依然从属于现代化框架范畴,作为新质生产力支配着现代世界,加剧了地球异化和世界异化的过程。人工智能的本质是人工机器语言、人工智能的趋势是群体智能、人工智能的危机依然是现代性危机。宇宙视角赋予人类科学自由,人类也不必受地球境况的局限,应当是地球的守护者、公共领域的建设者和宇宙公民。沿着阿伦特开创的以宇宙视角拯救现代性危机的路径应对人工智能危机,将为当前廓清人文与技术迷思提供重要参考。},
  language = {zh-CN},
  note = {original-container-title: Journal of Arts Management
foundation: 浙江省教育科学规划课题项目“疫情防控常态化背景下高校开展休闲伦理教育的探索与实践”(项目编号:2021SCG287)； 杭州市哲学社会科学规划课题“元宇宙时代杭州城市形象的美学建构”(项目编号:M23JC103)； 教育部中外语言交流合作中心国际中文教育研究课题“AIGC(GPT-4)赋能新时代全球国际中文教育大模型基础研究”(项目编号:23YH47C)；
