@article{ref2026e3pnb2r9,
  author = {郭欢},
  title = {现存亚里士多德作品集的起源——对托勒密目录的译介及分析},
  journal = {世界哲学},
  number = {2},
  pages = {54-72},
  url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CJFQ&dbname=CJFDAUTO&filename=ZXYC202602005},
  abstract = {在尚存的有关亚里士多德作品的三个古代目录中，有一个目录与我们如今所接受的亚里士多德作品集最为相似，这就是托勒密目录。它是亚里士多德作品集在历史演变过程中的重要见证，但长久以来并未受到应有的重视，相关研究也一度陷入瓶颈，直到20世纪40年代，伊斯坦布尔抄本Ayasofya 4833被发现，里面出现了一个前所未闻的资料——托勒密写的序言。在序言中，托勒密向盖勒斯解释了他设计该目录的初衷及方法。无疑，这个序言是我们正确理解托勒密目录的关键。通过对序言的分析，可知托勒密目录是由安德罗尼科目录改造而来。托勒密追求简约，删除了安德罗尼科目录中的三项内容，但顺序是他原创的，这意味着托勒密目录或许才是现存亚里士多德作品集的源头。鉴于此，我们认为有必要介绍托勒密目录的研究历程及现状，呼吁更多学者关注亚里士多德作品集的诞生及历史演变问题。},
  language = {zh},
}

